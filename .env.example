# ------------------------------------------------------------------
# Mood Sense — environment variables
# Copy this file to `.env` and fill in the values for your machine.
# The defaults below match the local docker-compose.yml services.
# ------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL — docker compose service `postgres`)
DATABASE_URL="postgresql://moodsense:moodsense@localhost:5432/moodsense?schema=public"

# Redis (docker compose service `redis`; in production use an Upstash URL)
REDIS_URL="redis://localhost:6379"

# Meilisearch (docker compose service `meilisearch`)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="moodsense-local-master-key"
# Public search-only key (generated in Phase 2 via Meilisearch API — never expose the master key)
NEXT_PUBLIC_MEILISEARCH_HOST="http://localhost:7700"
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=""

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# Vercel Blob (image storage) — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Seed users (local dev only) — emails: admin@moodsense.dev / cliente@moodsense.dev
SEED_ADMIN_PASSWORD="admin1234"
SEED_USER_PASSWORD="cliente1234"

# Transactional email (password recovery) — filled in Phase 5
RESEND_API_KEY=""
EMAIL_FROM="Mood Sense <no-reply@moodsense.store>"
