# ==================================================================
# Mood Sense: variables de entorno (configuración de la tienda)
# ==================================================================
# CÓMO USAR ESTE ARCHIVO
#   1. Copiarlo con el nombre `.env`:  cp .env.example .env
#   2. Completar los valores que estén vacíos ("").
#   3. Reiniciar el servidor (`npm run dev`) después de cada cambio:
#      los valores se leen solo al arrancar.
#
# REGLAS IMPORTANTES
#   - `.env` tiene secretos: NUNCA se sube a git ni se comparte por chat.
#     Este archivo (`.env.example`) sí se sube, por eso solo lleva valores de
#     ejemplo inofensivos.
#   - Las variables que empiezan con NEXT_PUBLIC_ son VISIBLES para cualquier
#     visitante del sitio (viajan al navegador). Ahí nunca va un secreto.
#   - Los valores van entre comillas dobles y sin espacios alrededor del "=".
#   - Los valores por defecto coinciden con los servicios de `docker compose`
#     (base de datos, Meilisearch, Redis) para desarrollo local.
#   - En producción (Vercel) estas mismas variables se cargan en
#     Project → Settings → Environment Variables, no con este archivo.
# ==================================================================


# ------------------------------------------------------------------
# 1. SITIO
# ------------------------------------------------------------------
# Dirección pública de la tienda, sin "/" al final. Se usa para armar los
# links del sitemap, de Google (SEO), de las imágenes al compartir en redes
# y de los mensajes de WhatsApp.
#   Local:      http://localhost:3000
#   Producción: https://tu-dominio.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------
# 2. BASE DE DATOS (obligatoria)
# ------------------------------------------------------------------
# Conexión a PostgreSQL, donde se guardan productos, usuarios, pedidos y
# stock. El valor de ejemplo apunta al contenedor de `docker compose`.
# En producción se usa la URL que entrega Neon (termina en ?sslmode=require).
# SECRETO: contiene usuario y contraseña de la base de datos.
DATABASE_URL="postgresql://moodsense:moodsense@localhost:5432/moodsense?schema=public"


# ------------------------------------------------------------------
# 3. BUSCADOR (Meilisearch)
# ------------------------------------------------------------------
# Servidor del buscador de la página /search (tolera errores de tipeo).
# Local: el contenedor de `docker compose`. Producción: Meilisearch Cloud.
MEILISEARCH_HOST="http://localhost:7700"
# Clave maestra del buscador. Solo la usa el servidor para buscar y para
# reindexar (`npm run search:sync`). En local debe coincidir con la de
# docker-compose.yml.
# SECRETO: nunca ponerla en una variable NEXT_PUBLIC_.
MEILISEARCH_MASTER_KEY="moodsense-local-master-key"


# ------------------------------------------------------------------
# 4. LOGIN DE USUARIOS (Auth.js) (obligatoria)
# ------------------------------------------------------------------
# Clave con la que se firman las sesiones de los usuarios. Si alguien la
# conoce, podría hacerse pasar por cualquier usuario (incluido el admin).
# Generarla con:  npx auth secret   (o cualquier texto aleatorio de 32+ caracteres)
# Cambiarla cierra la sesión de todos los usuarios.
# SECRETO.
AUTH_SECRET=""
# Dirección del sitio para el sistema de login. Igual a NEXT_PUBLIC_APP_URL.
AUTH_URL="http://localhost:3000"
# OPCIONAL: botón "Continuar con Google". Si se dejan vacías, el botón no
# aparece y solo funciona email + contraseña. Se obtienen en
# https://console.cloud.google.com/apis/credentials (OAuth client ID, tipo
# "Web application"; URI de redirección: <APP_URL>/api/auth/callback/google).
# AUTH_GOOGLE_SECRET es SECRETO.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# ------------------------------------------------------------------
# 5. FORMA DE COBRO
# ------------------------------------------------------------------
# Cómo se cobran los pedidos:
#   "whatsapp" (por defecto): el cliente deja sus datos, el pedido queda
#              "pendiente de pago" con el stock apartado y se coordina el
#              pago por WhatsApp. El admin lo marca como pagado a mano.
#   "stripe":  pago con tarjeta en Stripe. Requiere la sección 7.
NEXT_PUBLIC_CHECKOUT_MODE="whatsapp"


# ------------------------------------------------------------------
# 6. WHATSAPP (solo modo "whatsapp")
# ------------------------------------------------------------------
# Número de la tienda que RECIBE el aviso de cada pedido nuevo.
# Formato internacional, solo dígitos, sin "+", espacios ni guiones.
#   Ejemplo República Dominicana: 18095550100
#
# ATENCIÓN: con SOLO este número NO llega ningún mensaje automático. Sin las
# dos claves de la Cloud API de abajo, el pedido solo queda en el panel admin
# (Pedidos) y el servidor anota su número en el registro (sin datos del cliente).
#
# Este número también aparece en el botón "Coordinar pago por WhatsApp" que
# ve el cliente al terminar su pedido (es público).
WHATSAPP_OPERATOR_PHONE=""
# OPCIONAL: aviso AUTOMÁTICO por WhatsApp al operador. Requiere una cuenta
# de WhatsApp Business Cloud API en Meta (https://developers.facebook.com,
# producto "WhatsApp"). Con las DOS completas, cada pedido nuevo se envía
# solo al WHATSAPP_OPERATOR_PHONE.
#   TOKEN:           token de acceso permanente (usuario de sistema). SECRETO.
#   PHONE_NUMBER_ID: el "Phone number ID" del número emisor de Meta (no es
#                    el número de teléfono en sí).
# Limitación de Meta: un mensaje de texto libre solo se entrega si el número
# del operador le escribió al número emisor en las últimas 24 horas. Para
# que llegue siempre, el operador debe escribirle a ese número una vez al
# día, o hay que migrar a una "plantilla" aprobada por Meta.
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
# Horas que un pedido puede quedar "pendiente de pago" antes de cancelarse
# solo y devolver el stock a la tienda. Por defecto 48.
ORDER_PAYMENT_EXPIRY_HOURS="48"
# Contraseña de la tarea automática que cancela los pedidos vencidos
# (Vercel la llama una vez al día en /api/cron/expire-orders; además corre
# cada vez que un admin abre la lista de pedidos). Cualquier texto
# aleatorio largo. En Vercel debe tener el mismo nombre: CRON_SECRET.
# SECRETO.
CRON_SECRET=""


# ------------------------------------------------------------------
# 7. STRIPE: pago con tarjeta (solo modo "stripe")
# ------------------------------------------------------------------
# Claves de https://dashboard.stripe.com/test/apikeys (usar las de
# PRUEBA, sk_test_..., hasta salir a producción).
# Clave secreta para crear cobros. SECRETO.
STRIPE_SECRET_KEY=""
# Firma que prueba que un aviso de "pago completado" viene de Stripe.
# Local: la imprime `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# Producción: Stripe → Developers → Webhooks → endpoint → "Signing secret".
# SECRETO.
STRIPE_WEBHOOK_SECRET=""


# ------------------------------------------------------------------
# 8. SUBIDA DE IMÁGENES (Vercel Blob) (opcional)
# ------------------------------------------------------------------
# Permite usar el botón "Subir archivo" del formulario de productos del
# admin. Sin este token, ese botón responde que no está disponible y hay
# que pegar la URL de la imagen a mano. Se obtiene en Vercel → Storage →
# Blob → tu store → ".env.local". SECRETO.
BLOB_READ_WRITE_TOKEN=""


# ------------------------------------------------------------------
# 9. USUARIOS DE PRUEBA (solo desarrollo local)
# ------------------------------------------------------------------
# Contraseñas de las cuentas que crea `npm run db:seed`:
#   admin@moodsense.dev  (administrador)  → SEED_ADMIN_PASSWORD
#   cliente@moodsense.dev (cliente)       → SEED_USER_PASSWORD
# NUNCA correr el seed en producción con estas contraseñas.
SEED_ADMIN_PASSWORD="admin1234"
SEED_USER_PASSWORD="cliente1234"


# ------------------------------------------------------------------
# 10. NO SE USAN ACTUALMENTE (reservadas para funciones futuras)
# ------------------------------------------------------------------
# Caché Redis: el código todavía no lo usa.
REDIS_URL="redis://localhost:6379"
# Emails automáticos (por ejemplo, recuperar contraseña): todavía no
# implementados. RESEND_API_KEY es SECRETO cuando se use.
RESEND_API_KEY=""
EMAIL_FROM="Mood Sense <no-reply@moodsense.store>"
